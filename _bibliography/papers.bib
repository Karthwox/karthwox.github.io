@misc{annadurai2026securityskill,
  abbr        = {Preprint},
  bibtex_show = {true},
  selected    = {true},
  title       = {Does a Security Skill Beat a One-Line Reminder? A Blinded, Pre-Registered Test of Agent Skill Files for Safer AI-Generated Code},
  author      = {Annadurai, Karthik},
  year        = {2026},
  month       = nov,
  publisher   = {Zenodo},
  doi         = {10.5281/zenodo.24042353},
  code        = {https://doi.org/10.5281/zenodo.23498723},
  abstract    = {AI coding agents often build working apps while leaving out security protections nobody asked for. This study tests a security skill file for Codex CLI against a one-line security reminder, no guidance, and a public security skill, using pre-registered decision rules, blinded code review and a feature-fidelity check. On a stronger model, the reminder alone removed every critical failure on the original prompts. On a weaker model, the skill was not detectably better than the reminder on fresh prompt variants or on ten probes mapped to the OWASP Top 10. A final 400-run phase added a security checklist and a length-matched placebo: the reminder, checklist and skill each cut critical failures substantially while the placebo did not, and the skill showed no detectable advantage over the reminder (+5 points in failure rate, 95% interval -9 to +19) at 1.7 times the tokens of no guidance. Security content, not instruction length, appears to carry most of the benefit.}
}
